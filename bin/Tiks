#!/data/data/com.termux/files/usr/bin/bash

# TikSaver - TikTok Video Downloader
# Author: jaaavadm-glitch
# License: MIT

VERSION="1.0.0"
OUTPUT_DIR="/storage/emulated/0/Download/TikSaver"
CONFIG_DIR="$HOME/.tiktok-saver"
LOG_FILE="$CONFIG_DIR/history.log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# Banner
show_banner() {
    echo -e "${CYAN}"
    echo "  _____ _ _    _____                  "
    echo " |_   _(_) | _/ ____|_ ___ _   _____ _ "
    echo "   | | | | |/ / (___| |/ _ \\ \\ / / _ \\ |"
    echo "   | | | |   < \\___ \\ |  __/\\ V /  __/ |"
    echo "   |_| |_|_|\\_\\_____/_|\\___| \\_/ \\___|_|"
    echo -e "${NC}"
    echo -e "        ${BOLD}TikSaver v${VERSION}${NC}"
    echo -e "        ${CYAN}by jaaavadm-glitch${NC}"
    echo ""
}

# Help
show_help() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "  tiks <tiktok-url>          Download video"
    echo "  tiks -a <tiktok-url>       Download audio only (MP3)"
    echo "  tiks -h                    Show this help"
    echo "  tiks -v                    Show version"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  tiks https://vt.tiktok.com/ZSxxxxx/"
    echo "  tiks -a https://www.tiktok.com/@user/video/12345"
    echo ""
    echo -e "${BOLD}OUTPUT:${NC}"
    echo "  $OUTPUT_DIR"
    echo ""
}

# Version
show_version() {
    echo "TikSaver v${VERSION} by jaaavadm-glitch"
}

# Log download
log_download() {
    mkdir -p "$CONFIG_DIR"
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $1" >> "$LOG_FILE"
}

# Validate URL
validate_url() {
    local url="$1"
    if [[ "$url" =~ tiktok\.com ]]; then
        return 0
    else
        return 1
    fi
}

# Spinner
spinner() {
    local pid=$1
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        i=$(( (i+1) % 10 ))
        printf "\r${CYAN}  ${spin:$i:1} Downloading...${NC}"
        sleep 0.1
    done
    printf "\r"
}

# Main download
download_video() {
    local url="$1"
    local audio_only="$2"

    mkdir -p "$OUTPUT_DIR"

    echo -e "${CYAN}>> Preparing download...${NC}"
    echo -e "   Link: ${BOLD}$url${NC}"
    echo ""

    # Fake stages
    echo -e "${YELLOW}  [Stage 1/3]${NC} Fetching video info..."
    sleep 0.5
    echo -e "${YELLOW}  [Stage 2/3]${NC} Extracting media stream..."

    # Run silently in background
    if [ "$audio_only" = "true" ]; then
        OUTPUT_TEMPLATE="$OUTPUT_DIR/%(title)s.%(ext)s"
        (yt-dlp \
            -x --audio-format mp3 \
            -o "$OUTPUT_TEMPLATE" \
            --no-playlist \
            --quiet --no-warnings \
            --no-check-certificates \
            "$url" > /dev/null 2>&1) &
    else
        OUTPUT_TEMPLATE="$OUTPUT_DIR/%(title)s.%(ext)s"
        (yt-dlp \
            -o "$OUTPUT_TEMPLATE" \
            -f "bestvideo+bestaudio/best" \
            --merge-output-format mp4 \
            --no-playlist \
            --quiet --no-warnings \
            --no-check-certificates \
            "$url" > /dev/null 2>&1) &
    fi

    local pid=$!
    spinner "$pid"
    wait "$pid"
    local exit_code=$?

    echo -e "${YELLOW}  [Stage 3/3]${NC} Finalizing..."
    sleep 0.3

    if [ $exit_code -eq 0 ]; then
        echo ""
        echo -e "${GREEN}  ✅ Done!${NC}"
        echo -e "  📁 ${OUTPUT_DIR}"
        echo ""
        log_download "$url"
    else
        echo ""
        echo -e "${RED}  ❌ Download failed.${NC}"
        echo -e "  Please check the URL and try again."
        echo ""
        exit 1
    fi
}

# ─── Main ───────────────────────────────────────────

AUDIO_ONLY="false"
URL=""

case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        show_version
        exit 0
        ;;
    -a|--audio)
        AUDIO_ONLY="true"
        URL="$2"
        ;;
    "")
        show_banner
        echo -e "${RED}  Error: No URL provided.${NC}"
        echo -e "  Run ${CYAN}tiks -h${NC} for help."
        echo ""
        exit 1
        ;;
    *)
        URL="$1"
        ;;
esac

if [ -z "$URL" ]; then
    echo -e "${RED}  Error: No URL provided.${NC}"
    exit 1
fi

if ! validate_url "$URL"; then
    echo -e "${RED}  Error: Not a valid TikTok URL.${NC}"
    exit 1
fi

download_video "$URL" "$AUDIO_ONLY"
